# ── Backend (FastAPI) ─────────────────────────────────────────────
# SQLite database file for app state (holdings, targets, snapshots, quote cache).
DATABASE_URL=sqlite:///./data/app.db

# brapi.dev token (free signup at https://brapi.dev). Empty = tokenless/yfinance-only.
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api

# Comma-separated origins allowed by CORS (the frontend dev server).
CORS_ORIGINS=http://localhost:5173

# Path to the existing ticker->CNPJ catalog (reused from the legacy tool).
CATALOG_PATH=../data/b3_enterprises.xlsx

# Minutes a cached "latest" quote is considered fresh before refetching.
QUOTE_CACHE_TTL_MINUTES=60

# Desired allocation seed (JSON). Class-level and/or ticker-level.
# Example: {"class": {"Ação": 40, "FII": 30, "ETF": 20, "BDR": 10}}
TARGET_ALLOCATIONS={"class": {"Ação": 40, "FII": 30, "ETF": 20, "BDR": 10}}

# Daily refresh/snapshot job (task 13): an in-process scheduler runs the quote refresh +
# portfolio snapshot every JOB_INTERVAL_HOURS. Set RUN_SCHEDULER=0 to disable it (e.g. if
# you drive POST /api/jobs/run-daily from an external cron instead).
RUN_SCHEDULER=1
JOB_INTERVAL_HOURS=12

# ── Frontend (Vite) — put in frontend/.env ────────────────────────
VITE_API_BASE_URL=http://localhost:8000
